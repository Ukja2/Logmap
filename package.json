{
  "name": "logmap",
  "version": "0.1.0",
  "private": true,
  "description": "내 PC의 마크다운 파일을 캔버스에 카드로 띄우고 마인드맵처럼 연결해 정리하는 macOS 이력 관리 앱",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && env -u ELECTRON_RUN_AS_NODE VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build && node scripts/third-party-licenses.cjs",
    "start": "vite build && node scripts/third-party-licenses.cjs && env -u ELECTRON_RUN_AS_NODE electron .",
    "dist": "vite build && node scripts/third-party-licenses.cjs && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.local.logmap",
    "productName": "Logmap",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null
    }
  },
  "productName": "Logmap"
}
